# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=doggzi
POSTGRES_PASSWORD=
# Long random strings (e.g. `openssl rand -hex 32`)
GUEST_JWT_SECRET=
AUTH_JWT_SECRET=
INTERNAL_TOKEN=
# console = OTPs are printed in the notification log (local dev)
SMS_PROVIDER=console
SMS_PROVIDER_API_KEY=
# true only for local dev: the OTP is also shown on screen
OTP_DEV_ECHO=true
# Comma-separated mobile numbers that get the ADMIN role
ADMIN_PHONES=
# mock until Razorpay test keys are provided
PAYMENTS_MODE=mock
# HMAC key for customers' 4-digit start/end codes (long random string)
CODE_SECRET=
# OPS help line for the Provider panel's "Need help" (digits incl. country code, e.g. 919800000000)
OPS_WHATSAPP=
OFFER_TTL_SECONDS=90
# Local / demo server only: create the demo console logins and demo data
# (9000000001 Provider, 9000000002 Vendor, 9000000003 Admin, 9000000004 Ops, 9000000005 Provider+Vendor)
SEED_DEMO=false
