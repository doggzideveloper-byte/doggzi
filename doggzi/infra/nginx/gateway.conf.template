# Doggzi gateway. The frontend only ever talks to /api/<service>/v1/... through here.
# Rendered by the nginx image's envsubst (only the ${...UPSTREAM} variables below are substituted).

map $http_user_agent $dz_app_store {
    default                    desktop;
    ~*(iphone|ipad|ipod)       ios;
    ~*android                  android;
}

server {
    listen 80;
    server_name _;
    # Docker's DNS. Upstreams are resolved per request (variables below), so the gateway starts even
    # if a service is still booting, and picks up restarted containers' new IPs.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;
    set $pet_profile http://${PET_PROFILE_UPSTREAM};
    set $booking     http://${BOOKING_UPSTREAM};
    set $auth        http://${AUTH_UPSTREAM};
    set $market      http://${MARKET_UPSTREAM};
    set $web         http://${WEB_UPSTREAM};
    set $console     http://${CONSOLE_UPSTREAM};
    client_max_body_size 1m;

    # Compress API JSON and anything upstream sent uncompressed (the web container gzips its own assets).
    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
    gzip_types text/plain text/css text/javascript application/javascript application/json image/svg+xml;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_http_version 1.1;

    # Service-to-service routes are never public.
    location ~ ^/api/[^/]+/v1/internal/ { return 404; }
    location /api/pet-profile/ { proxy_pass $pet_profile; }
    location /api/booking/     { proxy_pass $booking; }
    location /api/auth/        { proxy_pass $auth; }
    location /api/market/      { proxy_pass $market; }
    # notification is internal only (auth → notification); never exposed publicly.
    location /api/notification/ { return 404; }
    location /api/             { return 404; }

    # Smart Download QR target: send phones to the right store, desktops to the download section.
    location = /app {
        if ($dz_app_store = ios)     { return 302 https://apps.apple.com/in/app/doggzi/id6757533673; }
        if ($dz_app_store = android) { return 302 https://play.google.com/store/apps/details?id=com.doggzi.doggzi&hl=en_IN&referrer=utm_source%3Dweb%26utm_medium%3Dqr; }
        return 302 /fresh-food#download;
    }

    # Doggzi Console (Admin / Vendor / Provider panels)
    location /console { proxy_pass $console; }

    location / { proxy_pass $web; }
}
